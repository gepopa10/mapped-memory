{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run MyCppApp",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/MyCppApp",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            // "console": "integratedTerminal",  // ✅ use VS Code terminal
            "externalConsole": false, // ✅ do not open new terminal
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}